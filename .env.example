# 既有的 PostgreSQL 資料庫（舊系統轉檔的副本）。本系統不會建立或修改任何資料表結構。
DATABASE_URL="postgresql://tidebit:password@127.0.0.1:5432/tidebit"

# 網站網址（可多個，逗號分隔；未寫協定時視為 https）。CAFECA 簽章的網址必須是其中之一。
# 未設定時預設 legacy.tidebit-defi.com、tidebit.com；www.tidebit.com 屬於不同網址，需要時請另外列出。
# 本機以 npm start 測試時請加入 http://localhost:10011（npm run dev 會自動允許 localhost 與 127.0.0.1）
APP_ORIGINS="legacy.tidebit-defi.com,tidebit.com"

# 簽署 session cookie 與一次性驗證資料，至少 32 字元的隨機字串（openssl rand -base64 48）
SESSION_SECRET=""

# 管理員：以 Email 指定角色（SUPER / OPERATOR / SUPPORT / AUDITOR），以自己的 TideBit 會員帳密登入 /admin
# 這裡的帳號後台無法修改；其他管理員可由 SUPER 在後台「管理員」頁指派
ADMINS="admin@tidebit.com:SUPER,ops@tidebit.com:OPERATOR,cs@tidebit.com:SUPPORT"

# CAFECA 錢包網址（讀取 /.well-known/cafeca-configuration 與 /sdk/cafeca-connect.js）
CAFECA_WALLET_URL="https://cafeca.io"
# 選填：自架或付費 RPC
# CAFECA_RPC_URL=""
# 正式實名要求 PRODUCTION 簽章者（CAFECA 原型期請維持 false）
CAFECA_REQUIRE_PRODUCTION_SIGNER="false"
# 僅開發環境：以模擬的 CAFECA 身分完成簽署（production 一律無效）
CAFECA_MOCK="false"

# 管理員登入需以 CAFECA 完成第二因素（production 預設 true）
ADMIN_REQUIRE_CAFECA="true"
# 提領「核准」與「出款」需由不同管理員執行（預設 true）
WITHDRAW_FOUR_EYES="true"

# 舊系統市場設定（委託／成交的市場名稱）；預設 config/markets.yml
# MARKETS_FILE="config/markets.yml"
# 選填：若 accounts.currency 與 asset_bases.id 對不上，指向舊系統正式環境的 coins.yml
# COINS_FILE="../TideBit-Lagacy/config/markets/coins.yml"

# 洗錢防制：OFAC 制裁名單來源（可改為本機檔案路徑，供無法連外的伺服器使用）
# AML_OFAC_SDN_URL="https://www.treasury.gov/ofac/downloads/sdn.csv"
# AML_OFAC_ALT_URL="https://www.treasury.gov/ofac/downloads/alt.csv"
# 選填：其他制裁地址清單（每行一個地址，逗號分隔多個網址）
# AML_ADDRESS_LIST_URLS=""

# 寄信（未設定時只會輸出到 log）
SMTP_URL="smtps://user:pass@smtp.example.com:465"
MAIL_FROM="TideBit <no-reply@tidebit.com>"
